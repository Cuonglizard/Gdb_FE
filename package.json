{
  "name": "gdbgui-frontend",
  "version": "1.0.0",
  "description": "React/TypeScript frontend for GDB GUI",
  "main": "src/js/gdbgui.tsx",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-check": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\"",
    "test": "jest",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.3.0",
    "codemirror": "^5.65.19",
    "react": "^18.2.0",
    "react-codemirror2": "^8.0.1",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.8.1",
    "statorgfc": "^0.1.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/jquery": "^3.5.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^29.6.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.0",
    "vite": "^4.4.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "keywords": [
    "gdb",
    "debugger",
    "react",
    "typescript",
    "frontend"
  ],
  "author": "Your Name",
  "license": "MIT",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts?(x)",
      "**/?(*.)+(spec|test).ts?(x)"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/src/js/$1"
    }
  }
}
